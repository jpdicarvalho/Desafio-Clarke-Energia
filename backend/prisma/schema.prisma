generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Fornecedor {
  id                 Int     @id @default(autoincrement())
  nome               String
  logo               String
  estado             String
  custo_por_kwh      Float
  limite_minimo_kwh  Int

  avaliacoes         Avaliacao[]  // Relacionamento com avaliações
  clientesAtendidos  ClienteAtendido?  // Relacionamento 1-1 opcional com clientes atendidos

  @@map("fornecedores") // Nome real da tabela no banco
}

model Avaliacao {
  id           Int        @id @default(autoincrement())
  fornecedorId Int
  nota         Float      @default(0)
  comentario   String?
  data         DateTime   @default(now())
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)

  @@index([fornecedorId], map: "avaliacoes_fornecedorId_fkey")
  @@map("avaliacoes")
}

model ClienteAtendido {
  id            Int     @id @default(autoincrement())
  fornecedorId  Int     @unique // Um fornecedor tem um único número de clientes atendidos
  quantidade    Int     @default(0) // Número total de clientes atendidos

  fornecedor    Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade) // Relacionamento

  @@map("clientes_atendidos") // Nome real da tabela no banco
}
